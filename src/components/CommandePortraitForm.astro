---
// Même mécanisme que DevisForm.astro (Netlify Forms, soumission en AJAX) mais avec les
// champs pertinents pour une commande de portrait plutôt qu'un devis événementiel (pas de
// "type d'événement", "lieu", "nombre d'invités"...). Pas d'upload de photos : plus simple
// et plus fiable de les demander par email une fois la demande validée (la soumission AJAX
// existante encode le formulaire en URL, pas en multipart — un upload fichier aurait demandé
// de réécrire ce mécanisme).
interface Champs {
  nom: string;
  email: string;
  telephone: string;
  format: string;
  formatPlaceholder: string;
  formatOptions: string[];
  personnes: string;
  personnalisations: string;
  date: string;
  photosNote: string;
  adresse: string;
  message: string;
  consentement: string;
  conservation: string;
  envoyer: string;
}
interface Props {
  champs: Champs;
  confirmationTitre: string;
  confirmation: string;
  erreur: string;
  contactEmail: string;
}
const { champs, confirmationTitre, confirmation, erreur, contactEmail } = Astro.props;

const fieldClass =
  'mt-1.5 w-full rounded-md border border-ink/15 bg-paper px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 outline-none transition-colors focus:border-violet-400';
const labelClass = 'block text-sm text-ink-soft';
---

<form
  name="commande-portrait"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  id="commande-form"
  class="grid grid-cols-1 gap-5 md:grid-cols-2"
>
  <input type="hidden" name="form-name" value="commande-portrait" />
  <p class="hidden">
    <label>Ne pas remplir si vous êtes humain : <input name="bot-field" /></label>
  </p>

  <div>
    <label class={labelClass} for="commande-nom">{champs.nom}</label>
    <input class={fieldClass} type="text" id="commande-nom" name="nom" required />
  </div>
  <div>
    <label class={labelClass} for="commande-email">{champs.email}</label>
    <input class={fieldClass} type="email" id="commande-email" name="email" required />
  </div>

  <div>
    <label class={labelClass} for="commande-telephone">{champs.telephone}</label>
    <input class={fieldClass} type="tel" id="commande-telephone" name="telephone" />
  </div>
  <div>
    <label class={labelClass} for="commande-format">{champs.format}</label>
    <select class={fieldClass} id="commande-format" name="format_souhaite" required>
      <option value="">{champs.formatPlaceholder}</option>
      {champs.formatOptions.map((opt) => <option value={opt}>{opt}</option>)}
    </select>
  </div>

  <div>
    <label class={labelClass} for="commande-personnes">{champs.personnes}</label>
    <input class={fieldClass} type="text" id="commande-personnes" name="nombre_personnes" required />
  </div>
  <div>
    <label class={labelClass} for="commande-date">{champs.date}</label>
    <input class={fieldClass} type="text" id="commande-date" name="date_souhaitee" />
  </div>

  <div class="md:col-span-2">
    <label class={labelClass} for="commande-personnalisations">{champs.personnalisations}</label>
    <textarea class={fieldClass} id="commande-personnalisations" name="personnalisations" rows="3"></textarea>
  </div>

  <div class="md:col-span-2 rounded-md border border-violet-200 bg-violet-50 px-3.5 py-2.5 text-sm text-violet-600">
    {champs.photosNote}
  </div>

  <div class="md:col-span-2">
    <label class={labelClass} for="commande-adresse">{champs.adresse}</label>
    <input class={fieldClass} type="text" id="commande-adresse" name="adresse_livraison" />
  </div>

  <div class="md:col-span-2">
    <label class={labelClass} for="commande-message">{champs.message}</label>
    <textarea class={fieldClass} id="commande-message" name="message" rows="4"></textarea>
  </div>

  <div class="md:col-span-2">
    <label class="flex items-start gap-2.5 text-sm text-ink-soft">
      <input
        type="checkbox"
        id="commande-consentement"
        name="consentement"
        required
        class="mt-0.5 h-4 w-4 shrink-0 rounded border-ink/30 text-violet-600 focus:ring-violet-400"
      />
      <span>{champs.consentement}</span>
    </label>
    <p class="mt-2 text-xs leading-relaxed text-ink-soft/80">{champs.conservation}</p>
  </div>

  <div class="md:col-span-2">
    <button
      type="submit"
      class="rounded-full bg-violet-600 px-7 py-3 text-sm text-paper transition-colors hover:bg-violet-700"
    >
      {champs.envoyer}
    </button>
  </div>
</form>

<div id="commande-confirmation" class="hidden rounded-lg border border-violet-200 bg-violet-50 px-6 py-8 text-center">
  <p class="font-serif text-xl text-violet-600">{confirmationTitre}</p>
  <p class="mt-2 text-ink-soft">{confirmation}</p>
</div>

<div id="commande-erreur" class="hidden mt-4 text-sm text-ink-soft">
  {erreur} <a href={`mailto:${contactEmail}`} class="text-violet-600 underline">{contactEmail}</a>.
</div>

<script>
  const form = document.getElementById('commande-form') as HTMLFormElement | null;
  const confirmationEl = document.getElementById('commande-confirmation');
  const erreurEl = document.getElementById('commande-erreur');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    erreurEl?.classList.add('hidden');

    const data = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();

    try {
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: data,
      });
      if (!response.ok) throw new Error(`Statut ${response.status}`);
      form.classList.add('hidden');
      confirmationEl?.classList.remove('hidden');
    } catch {
      erreurEl?.classList.remove('hidden');
    }
  });
</script>
