---
interface Champs {
  nom: string;
  email: string;
  telephone: string;
  typeProjet: string;
  date: string;
  lieu: string;
  invites: string;
  duree: string;
  prestation: string;
  prestationPlaceholder: string;
  prestationOptions: string[];
  besoins: string;
  budget: string;
  message: string;
  consentement: string;
  conservation: string;
  envoyer: string;
}
interface Props {
  champs: Champs;
  confirmationTitre: string;
  confirmation: string;
  erreur: string;
  contactEmail: string;
}
const { champs, confirmationTitre, confirmation, erreur, contactEmail } = Astro.props;

const fieldClass =
  'mt-1.5 w-full rounded-md border border-ink/15 bg-paper px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-soft/50 outline-none transition-colors focus:border-violet-400';
const labelClass = 'block text-sm text-ink-soft';
---

<form
  name="devis"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  id="devis-form"
  class="grid grid-cols-1 gap-5 md:grid-cols-2"
>
  <input type="hidden" name="form-name" value="devis" />
  <p class="hidden">
    <label>Ne pas remplir si vous êtes humain : <input name="bot-field" /></label>
  </p>

  <div>
    <label class={labelClass} for="devis-nom">{champs.nom}</label>
    <input class={fieldClass} type="text" id="devis-nom" name="nom" required />
  </div>
  <div>
    <label class={labelClass} for="devis-email">{champs.email}</label>
    <input class={fieldClass} type="email" id="devis-email" name="email" required />
  </div>

  <div>
    <label class={labelClass} for="devis-telephone">{champs.telephone}</label>
    <input class={fieldClass} type="tel" id="devis-telephone" name="telephone" />
  </div>
  <div>
    <label class={labelClass} for="devis-type">{champs.typeProjet}</label>
    <input class={fieldClass} type="text" id="devis-type" name="type_projet" required />
  </div>

  <div>
    <label class={labelClass} for="devis-date">{champs.date}</label>
    <input class={fieldClass} type="text" id="devis-date" name="date_souhaitee" />
  </div>
  <div>
    <label class={labelClass} for="devis-lieu">{champs.lieu}</label>
    <input class={fieldClass} type="text" id="devis-lieu" name="lieu" />
  </div>

  <div>
    <label class={labelClass} for="devis-invites">{champs.invites}</label>
    <input class={fieldClass} type="text" id="devis-invites" name="nombre_invites" />
  </div>
  <div>
    <label class={labelClass} for="devis-duree">{champs.duree}</label>
    <input class={fieldClass} type="text" id="devis-duree" name="duree" />
  </div>

  <div class="md:col-span-2">
    <label class={labelClass} for="devis-prestation">{champs.prestation}</label>
    <select class={fieldClass} id="devis-prestation" name="prestation_souhaitee">
      <option value="">{champs.prestationPlaceholder}</option>
      {champs.prestationOptions.map((opt) => <option value={opt}>{opt}</option>)}
    </select>
  </div>

  <div class="md:col-span-2">
    <label class={labelClass} for="devis-besoins">{champs.besoins}</label>
    <textarea class={fieldClass} id="devis-besoins" name="besoins_particuliers" rows="3"></textarea>
  </div>

  <div>
    <label class={labelClass} for="devis-budget">{champs.budget}</label>
    <input class={fieldClass} type="text" id="devis-budget" name="budget_indicatif" />
  </div>
  <div class="md:col-span-2">
    <label class={labelClass} for="devis-message">{champs.message}</label>
    <textarea class={fieldClass} id="devis-message" name="message" rows="4"></textarea>
  </div>

  <div class="md:col-span-2">
    <label class="flex items-start gap-2.5 text-sm text-ink-soft">
      <input
        type="checkbox"
        id="devis-consentement"
        name="consentement"
        required
        class="mt-0.5 h-4 w-4 shrink-0 rounded border-ink/30 text-violet-600 focus:ring-violet-400"
      />
      <span>{champs.consentement}</span>
    </label>
    <p class="mt-2 text-xs leading-relaxed text-ink-soft/80">{champs.conservation}</p>
  </div>

  <div class="md:col-span-2">
    <button
      type="submit"
      class="rounded-full bg-violet-600 px-7 py-3 text-sm text-paper transition-colors hover:bg-violet-700"
    >
      {champs.envoyer}
    </button>
  </div>
</form>

<div id="devis-confirmation" class="hidden rounded-lg border border-violet-200 bg-violet-50 px-6 py-8 text-center">
  <p class="font-serif text-xl text-violet-600">{confirmationTitre}</p>
  <p class="mt-2 text-ink-soft">{confirmation}</p>
</div>

<div id="devis-erreur" class="hidden mt-4 text-sm text-ink-soft">
  {erreur} <a href={`mailto:${contactEmail}`} class="text-violet-600 underline">{contactEmail}</a>.
</div>

<script>
  const form = document.getElementById('devis-form') as HTMLFormElement | null;
  const confirmationEl = document.getElementById('devis-confirmation');
  const erreurEl = document.getElementById('devis-erreur');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    erreurEl?.classList.add('hidden');

    const data = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();

    try {
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: data,
      });
      if (!response.ok) throw new Error(`Statut ${response.status}`);
      form.classList.add('hidden');
      confirmationEl?.classList.remove('hidden');
    } catch {
      erreurEl?.classList.remove('hidden');
    }
  });
</script>
