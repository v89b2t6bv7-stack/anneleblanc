---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface MediaItem {
  type: 'image' | 'video';
  src: ImageMetadata | string;
  alt?: string;
  fit?: 'cover' | 'contain'; // 'contain' = image entière visible, non recadrée ("dézoomée")
}

interface Slide {
  titre: string;
  media: MediaItem[]; // 1 item = plein cadre, 2 items = côte à côte
  panel?: 'violet' | 'blanc' | 'jaune'; // défaut violet
}

const panelStyles = {
  violet: { bg: 'bg-violet-700', text: 'text-paper' },
  blanc: { bg: 'bg-paper', text: 'text-violet-700' },
  jaune: { bg: 'bg-yellow-500', text: 'text-violet-700' },
};

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<section class="relative w-full" aria-label="Activités">
  <div class="relative h-[70vh] w-full overflow-hidden md:h-[calc(100vh-9rem)]">
    {slides.map((slide, i) => (
      <div
        class="carousel-slide absolute inset-0 flex flex-col transition-opacity duration-700 ease-in-out md:flex-row"
        data-index={i}
        style={i === 0 ? '' : 'opacity: 0; pointer-events: none;'}
      >
        <div class="flex h-[60%] w-full gap-0.5 md:h-full md:w-2/3">
          {slide.media.map((m) => (
            <div class={`relative h-full flex-1 overflow-hidden ${m.fit === 'contain' ? 'bg-paper' : ''}`}>
              {m.type === 'video' ? (
                <video class="carousel-video h-full w-full object-cover" src={m.src as string} muted loop playsinline preload="metadata" />
              ) : (
                <Image
                  src={m.src as ImageMetadata}
                  alt={m.alt ?? slide.titre}
                  widths={[400, 700, 1100, 1600]}
                  sizes={slide.media.length === 2 ? '(min-width: 768px) 33vw, 50vw' : '(min-width: 768px) 66vw, 100vw'}
                  class={`h-full w-full ${m.fit === 'contain' ? 'object-contain scale-110 translate-y-6' : 'object-cover'}`}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              )}
            </div>
          ))}
        </div>
        <div class={`flex h-[40%] w-full items-center justify-center px-8 py-8 text-center md:h-full md:w-1/3 ${panelStyles[slide.panel ?? 'violet'].bg} ${(slide.panel ?? 'violet') === 'blanc' ? 'border-t border-ink/10 md:border-l md:border-t-0' : ''}`}>
          <h3 class={`font-display text-3xl leading-tight md:text-4xl ${panelStyles[slide.panel ?? 'violet'].text}`}>{slide.titre}</h3>
        </div>
      </div>
    ))}

    <!-- Flèches -->
    <button
      class="carousel-prev absolute left-4 top-[30%] z-10 flex h-10 w-10 items-center justify-center rounded-full bg-paper/80 text-ink transition-colors hover:bg-paper md:top-1/2 md:-translate-y-1/2"
      aria-label="Activité précédente"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M11 3 5 9l6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button
      class="carousel-next absolute right-4 top-[30%] z-10 flex h-10 w-10 items-center justify-center rounded-full bg-paper/80 text-ink transition-colors hover:bg-paper md:top-1/2 md:-translate-y-1/2"
      aria-label="Activité suivante"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="m7 3 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>

    <!-- Points -->
    <div class="absolute bottom-4 left-1/2 z-10 flex -translate-x-1/2 gap-2 md:bottom-6">
      {slides.map((_, i) => (
        <button
          class="carousel-dot h-2 w-2 rounded-full bg-paper/60 transition-all data-[active=true]:w-5 data-[active=true]:bg-paper"
          data-index={i}
          data-active={i === 0 ? 'true' : 'false'}
          aria-label={`Aller à l'activité ${i + 1}`}
        />
      ))}
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('section[aria-label="Activités"]');
  if (section) {
    const slides = [...section.querySelectorAll<HTMLElement>('.carousel-slide')];
    const dots = [...section.querySelectorAll<HTMLElement>('.carousel-dot')];
    const prevBtn = section.querySelector<HTMLElement>('.carousel-prev');
    const nextBtn = section.querySelector<HTMLElement>('.carousel-next');
    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function show(index: number) {
      const previous = current;
      current = (index + slides.length) % slides.length;

      slides[previous].style.opacity = '0';
      slides[previous].style.pointerEvents = 'none';
      slides[previous].querySelectorAll('video').forEach((v) => v.pause());

      slides[current].style.opacity = '1';
      slides[current].style.pointerEvents = 'auto';
      slides[current].querySelectorAll('video').forEach((v) => {
        v.currentTime = 0;
        v.play().catch(() => {});
      });

      dots.forEach((dot, i) => dot.setAttribute('data-active', String(i === current)));
    }

    function restartAutoplay() {
      clearInterval(timer);
      timer = setInterval(() => show(current + 1), 5000);
    }

    prevBtn?.addEventListener('click', () => { show(current - 1); restartAutoplay(); });
    nextBtn?.addEventListener('click', () => { show(current + 1); restartAutoplay(); });
    dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); restartAutoplay(); }));

    restartAutoplay();
  }
</script>
