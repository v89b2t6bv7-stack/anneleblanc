---
interface QA {
  q: string;
  r: string;
}
interface Categorie {
  nom: string;
  questions: QA[];
}
interface Props {
  categories: Categorie[];
}
const { categories } = Astro.props;
---

<div class="space-y-12">
  {categories.map((cat) => (
    <div>
      <h3 class="font-serif text-lg text-violet-600 md:text-xl">{cat.nom}</h3>
      <div class="mt-4 divide-y divide-ink/10 border-t border-ink/10">
        {cat.questions.map((qa) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 marker:content-none">
              <span class="text-base text-violet-600 md:text-lg">{qa.q}</span>
              <svg class="mt-1.5 h-3.5 w-3.5 flex-shrink-0 text-violet-600 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </svg>
            </summary>
            <p class="mt-3 max-w-2xl pr-8 text-sm leading-relaxed text-ink-soft md:text-base">{qa.r}</p>
          </details>
        ))}
      </div>
    </div>
  ))}
</div>
