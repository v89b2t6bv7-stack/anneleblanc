---
import { useTranslations, getCurrentLang } from '../i18n';

const lang = getCurrentLang(Astro.url.pathname);
const t = useTranslations(lang);
const prefix = lang === 'en' ? '/en' : '';
const year = new Date().getFullYear();
---

<footer class="bg-violet-600">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-12 md:flex-row md:items-start md:justify-between">
    <div>
      <p class="font-serif text-lg text-paper">Anne Leblanc</p>
    </div>

    <div class="flex flex-col gap-2 text-sm text-violet-200">
      <a href={t.meta.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-yellow-400">
        {t.meta.instagramHandle} — Instagram/TikTok
      </a>
      <a href={`mailto:${t.meta.contactEmail}`} class="hover:text-yellow-400">{t.meta.contactEmail}</a>
      <a href={`${prefix}/contact`} class="hover:text-yellow-400">{t.nav.contact}</a>
    </div>
  </div>
  <div class="flex flex-col items-center gap-1 border-t border-paper/15 px-5 py-4 text-center text-xs text-violet-200/80 sm:flex-row sm:justify-center sm:gap-3">
    <span>© {year} Anne Leblanc</span>
    <a href={`${prefix}/mentions-legales`} class="hover:text-yellow-400">{t.nav.mentionsLegales}</a>
  </div>
</footer>
