---
interface Format {
  nom: string;
  dimensions: string;
  rows: [string, string][];
  supplement: string;
  note: string;
}
interface Props {
  format: Format;
}
const { format } = Astro.props;
---

<div class="flex h-full flex-col rounded-lg border border-ink/10 bg-paper p-6 md:p-7">
  <h4 class="font-serif text-xl text-violet-600">{format.nom}</h4>
  <p class="mt-1 text-sm text-ink-soft">{format.dimensions}</p>

  <table class="mt-5 w-full text-sm">
    <tbody>
      {format.rows.map(([label, price]) => (
        <tr class="border-t border-ink/10 first:border-t-0">
          <td class="py-2 text-ink-soft">{label}</td>
          <td class="py-2 text-right font-medium text-violet-600">{price}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <p class="mt-4 text-sm text-violet-600">{format.supplement}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{format.note}</p>
</div>
