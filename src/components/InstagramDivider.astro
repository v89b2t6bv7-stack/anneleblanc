---
import PencilStroke from './PencilStroke.astro';

interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<div class="flex items-center justify-center gap-4 px-5 md:gap-8">
  <div class="hidden h-9 flex-1 max-w-[13rem] sm:block">
    <PencilStroke variant="taper-gauche" class="h-full w-full text-violet-600" />
  </div>
  <a href={href} target="_blank" rel="noopener noreferrer" class="whitespace-nowrap font-display text-2xl text-ink transition-colors hover:text-violet-600 md:text-3xl">
    {label}
  </a>
  <div class="hidden h-9 flex-1 max-w-[13rem] sm:block">
    <PencilStroke variant="taper-droite" class="h-full w-full text-violet-600" />
  </div>
</div>
