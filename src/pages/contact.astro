---
import BaseLayout from '../layouts/BaseLayout.astro';
import PencilStroke from '../components/PencilStroke.astro';
import { useTranslations, getCurrentLang } from '../i18n';

const lang = getCurrentLang(Astro.url.pathname);
const t = useTranslations(lang);
const co = t.contact;
const prefix = lang === 'en' ? '/en' : '';

function hrefFor(type: string): string {
  if (type === 'devis') return `${prefix}/travailler-avec-moi#devis`;
  if (type === 'portraits') return `${prefix}/commande-portrait`;
  return `mailto:${t.meta.contactEmail}`;
}
---

<BaseLayout title="Contact — Anne Leblanc" description="Événement, commande, collaboration ou question : contactez Anne Leblanc, dessinatrice.">
  <!-- Intro -->
  <section class="mx-auto max-w-2xl px-5 pt-14 text-center md:pt-20">
    <p class="font-nav text-base uppercase tracking-[0.2em] text-violet-700 md:text-lg">{co.titre}</p>
    <p class="font-signature mt-3 text-xl leading-relaxed text-violet-600 md:text-2xl">{co.intro}</p>
  </section>

  <PencilStroke variant="ligne" class="mx-auto mt-6 h-7 w-56 text-violet-600 md:mt-8" />

  <!-- Les 4 portes d'entrée -->
  <section class="mx-auto max-w-5xl px-5 pb-4 pt-6 md:pt-8">
    <div class="grid gap-6 sm:grid-cols-2">
      {co.profils.map((profil: { type: string; titre: string; texte: string; cta: string }) => (
        <a
          href={hrefFor(profil.type)}
          class="group block rounded-2xl border border-violet-200 bg-violet-50 p-8 transition-colors hover:border-violet-600 hover:bg-violet-100"
        >
          <h2 class="font-serif text-xl text-violet-600 md:text-2xl">{profil.titre}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{profil.texte}</p>
          <span class="mt-6 inline-block font-nav text-xs uppercase tracking-[0.15em] text-violet-600 group-hover:underline">
            {profil.cta} →
          </span>
        </a>
      ))}
    </div>
  </section>

  <PencilStroke variant="ligne" class="mx-auto mt-10 h-7 w-56 -scale-x-100 text-violet-600 md:mt-14" />

  <!-- Coordonnées & réseaux sociaux -->
  <section class="mx-auto max-w-2xl px-5 pb-20 pt-14 text-center md:pt-16">
    <h2 class="text-2xl text-violet-600 md:text-3xl">{co.coordonneesTitre}</h2>
    <a href={`mailto:${t.meta.contactEmail}`} class="mt-4 inline-block font-serif text-lg text-violet-600 underline decoration-violet-300 underline-offset-4 hover:text-violet-700 md:text-xl">
      {t.meta.contactEmail}
    </a>

    <h2 class="mt-14 text-2xl text-violet-600 md:text-3xl">{co.reseauxTitre}</h2>
    <div class="mt-4 flex flex-col items-center gap-2 text-base text-ink-soft">
      <a href={t.meta.instagramUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-violet-600">
        Instagram — {t.meta.instagramHandle}
      </a>
      <a href={t.meta.tiktokUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-violet-600">
        TikTok — {t.meta.instagramHandle}
      </a>
      <a href={t.meta.youtubeUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-violet-600">
        YouTube — {t.meta.instagramHandle}
      </a>
    </div>
  </section>
</BaseLayout>
