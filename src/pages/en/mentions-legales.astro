---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, getCurrentLang } from '../../i18n';

const lang = getCurrentLang(Astro.url.pathname);
const t = useTranslations(lang);
const m = t.mentionsLegales;
---

<BaseLayout title={`${m.titre} — Anne Leblanc`} description={m.titre}>
  <section class="mx-auto max-w-2xl px-5 pb-20 pt-14 md:pt-20">
    <h1 class="font-display text-3xl text-violet-600 md:text-4xl">{m.titre}</h1>

    <div class="mt-10 space-y-10">
      <div>
        <h2 class="font-display text-xl text-violet-600">{m.editeur.titre}</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">{m.editeur.intro}</p>
        <ul class="mt-3 space-y-1 text-base leading-relaxed text-ink-soft">
          {m.editeur.items.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="font-display text-xl text-violet-600">{m.directeur.titre}</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">{m.directeur.texte}</p>
      </div>

      <div>
        <h2 class="font-display text-xl text-violet-600">{m.hebergement.titre}</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">{m.hebergement.texte}</p>
        <p class="mt-1 text-base leading-relaxed text-ink-soft">
          {m.hebergement.nom}<br />
          {m.hebergement.adresse}<br />
          <a href={m.hebergement.url} target="_blank" rel="noopener noreferrer" class="text-violet-600 underline hover:text-violet-700">{m.hebergement.url}</a>
        </p>
      </div>

      <div>
        <h2 class="font-display text-xl text-violet-600">{m.propriete.titre}</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">{m.propriete.texte}</p>
      </div>

      <div>
        <h2 class="font-display text-xl text-violet-600">{m.donnees.titre}</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">{m.donnees.texte}</p>
      </div>
    </div>
  </section>
</BaseLayout>
