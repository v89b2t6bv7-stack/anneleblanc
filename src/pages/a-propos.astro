---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PencilStroke from '../components/PencilStroke.astro';
import { useTranslations, getCurrentLang } from '../i18n';

import anneBioPhoto from '../assets/images/accueil/anne-portrait-bio.jpg';

const lang = getCurrentLang(Astro.url.pathname);
const t = useTranslations(lang);
const a = t.apropos;
const prefix = lang === 'en' ? '/en' : '';

interface Bloc { type: 'p' | 'quote'; texte: string; }
---

<BaseLayout title="Bio — Anne Leblanc" description="Le parcours d'Anne Leblanc : du théâtre à la scénographie, jusqu'au dessin sur le vif.">
  <!-- Disposition magazine : photo fixe (sticky) à gauche sur desktop, texte défilant à
       droite ; la photo se libère naturellement en fin de colonne de texte (sticky +
       self-start dans la grille, pas de JS nécessaire). Empilé simplement sur mobile. -->
  <section class="mx-auto max-w-5xl px-5 pb-20 pt-14 md:pt-20">
    <div class="md:grid md:grid-cols-[minmax(0,420px)_1fr] md:items-start md:gap-8 lg:gap-12">
      <div class="md:sticky md:top-32">
        <Image
          src={anneBioPhoto}
          alt="Anne Leblanc, carnet et crayon à la main, souriante"
          widths={[400, 700, 1000]}
          sizes="(min-width: 768px) 420px, 90vw"
          class="mx-auto aspect-[4/5] w-full max-w-sm rounded-md object-cover md:mx-0 md:max-w-none"
        />
      </div>

      <div class="mx-auto mt-10 max-w-2xl md:mx-0 md:mt-0">
        <p class="font-signature text-2xl leading-relaxed text-violet-600 md:text-3xl">{a.intro}</p>

        <div class="mt-8 space-y-6">
          {a.recit.map((bloc: Bloc) =>
            bloc.type === 'quote' ? (
              <blockquote class="border-l-2 border-violet-600/40 pl-6 md:pl-8">
                <p class="font-signature text-xl leading-relaxed text-violet-600 md:text-2xl">« {bloc.texte} »</p>
              </blockquote>
            ) : (
              <p class="text-lg leading-relaxed text-violet-600">{bloc.texte}</p>
            )
          )}
        </div>

        <PencilStroke variant="ligne" class="mx-auto mt-10 h-6 w-48 md:mx-0" />

        {a.sections.map((section: { titre: string; blocks: Bloc[] }) => (
          <div class="mt-10">
            <h3 class="text-xl text-violet-600 md:text-2xl">{section.titre}</h3>
            <div class="mt-4 space-y-6">
              {section.blocks.map((bloc: Bloc) =>
                bloc.type === 'quote' ? (
                  <blockquote class="border-l-2 border-violet-600/40 pl-6 md:pl-8">
                    <p class="font-signature text-xl leading-relaxed text-violet-600 md:text-2xl">« {bloc.texte} »</p>
                  </blockquote>
                ) : (
                  <p class="text-lg leading-relaxed text-violet-600">{bloc.texte}</p>
                )
              )}
            </div>
          </div>
        ))}

        <div class="mt-12 text-center">
          <a
            href={`${prefix}/travailler-avec-moi#devis`}
            class="inline-block rounded-full bg-violet-600 px-7 py-3 text-sm text-paper transition-colors hover:bg-violet-700"
          >
            {a.ctaDevis} →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
