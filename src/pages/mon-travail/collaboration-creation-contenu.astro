---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PencilStroke from '../../components/PencilStroke.astro';
import PortfolioGallery from '../../components/PortfolioGallery.astro';
import { useTranslations, getCurrentLang } from '../../i18n';
import type { ImageMetadata } from 'astro';

const lang = getCurrentLang(Astro.url.pathname);
const t = useTranslations(lang);
const p = t.portfolio;
const prefix = lang === 'en' ? '/en' : '';
const c = p.categories.find((c: { slug: string }) => c.slug === 'collaboration-creation-contenu');

function glob(pattern: string): ImageMetadata[] {
  const modules = import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/images/portfolio/**/*.{jpg,jpeg,png}',
    { eager: true }
  );
  return Object.keys(modules)
    .filter((key) => key.includes(pattern))
    .sort()
    .map((key) => modules[key].default);
}

const images = glob('/collaboration-creation-contenu/');
---

<BaseLayout title={`${c.titre} — Portfolio — Anne Leblanc`} description={c.texte}>
  <section class="mx-auto max-w-2xl px-5 pt-14 text-center md:pt-20">
    <a href={`${prefix}/mon-travail`} class="font-nav text-xs uppercase tracking-[0.15em] text-ink-soft transition-colors hover:text-violet-600"><span aria-hidden="true">←</span> {p.titre}</a>
    <h1 class="mt-5 font-serif text-3xl text-violet-600 md:text-4xl">{c.titre}</h1>
    <p class="mt-4 text-base leading-relaxed text-ink-soft">{c.texte}</p>
    <p class="mt-4 text-base leading-relaxed text-ink-soft">
      {p.collabInstagramTexte}{' '}
      <a
        href={t.meta.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-violet-600 underline decoration-violet-300 underline-offset-2 transition-colors hover:text-violet-700"
      >
        {p.collabInstagramCta} →
      </a>
    </p>
  </section>

  <!-- Argument commercial : la communauté Instagram/TikTok d'Anne, mise en avant
       comme un vrai atout pour les marques — pas juste une vitrine de contenu. -->
  <section class="mt-14 bg-violet-600 py-14 md:mt-16 md:py-16">
    <div class="mx-auto max-w-2xl px-5 text-center">
      <p class="font-display text-2xl leading-snug text-paper md:text-3xl">{t.travailler.intro.reseauxSociaux}</p>
      <a
        href={t.meta.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-10 inline-block rounded-full bg-yellow-500 px-7 py-3 text-sm text-violet-700 transition-colors hover:bg-yellow-400"
      >
        {p.instagramCta} {t.meta.instagramHandle}
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20 pt-14 md:pt-16">
    <PortfolioGallery images={images} altBase="Anne Leblanc en train de filmer ou de dessiner pour ses réseaux sociaux" />
  </section>
</BaseLayout>
