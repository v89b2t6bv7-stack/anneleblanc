---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCurrentLang } from '../i18n';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Anne Leblanc — artiste, dessinatrice, autrice. Elle observe les humains et transforme ce qu'elle voit en dessins." } = Astro.props;
const lang = getCurrentLang(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Bodoni+Moda:opsz,wght@6..96,500;6..96,600&family=Playfair+Display:wght@500;600&family=Manrope:wght@500;600&family=Caveat:wght@500;600&display=optional"
      rel="stylesheet"
    />
    <link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=optional" rel="stylesheet" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
